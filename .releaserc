{
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "npmPublish": false
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "npm run build:${process.env.TARGET_PLATFORM}",
        "publishCmd": "curl --user ${process.env.FORGEJO_REPOSITORY_OWNER}:${process.env.FORGEJO_TOKEN} --upload-file dist/lrepoflow-${nextRelease.version}-setup${process.env.TARGET_EXEC_EXT} https://git.reslate.solutions/api/packages/${process.env.FORGEJO_REPOSITORY_OWNER}/generic/lrepoflow/${nextRelease.version}/lrepoflow-${nextRelease.version}-setup.${process.env.TARGET_EXEC_EXT}"
      }
    ]
  ]
}
