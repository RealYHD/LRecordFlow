{
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "npm run build:${TARGET_PLATFORM}",
        "publishCmd": "curl --user ${FORGEJO_REPOSITORY_OWNER}:${FORGEJO_TOKEN} --upload-file dist/lrepoflow-${nextRelease.version}-setup${TARGET_EXEC_EXT} https://git.reslate.solutions/api/packages/${FORGEJO_REPOSITORY_OWNER}/generic/lrepoflow/${nextRelease.version}/lrepoflow-${nextRelease.version}-setup.${TARGET_EXEC_EXT}"
      }
    ]
  ]
}
