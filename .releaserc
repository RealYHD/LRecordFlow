{
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "npmPublish": false
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "npm run build:win",
        "publishCmd": "curl --user ${process.env.FORGEJO_REPOSITORY_OWNER}:${process.env.PACKAGE_UPLOAD_TOKEN} --upload-file dist/lrepoflow-${nextRelease.version}-setup.exe https://git.reslate.solutions/api/packages/${process.env.FORGEJO_REPOSITORY_OWNER}/generic/lrepoflow/${nextRelease.version}/lrepoflow-${nextRelease.version}-setup.exe"
      }
    ]
  ]
}
